<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/css/about.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    /* Popup 스타일 */
    .product-popup {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background-color: white;
      padding: 20px;
      border-radius: 5px;
      box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.2);
      z-index: 100;
    }

    .product-popup.active {
      display: block;
    }

    .popup-close {
      position: absolute;
      top: 10px;
      right: 10px;
      cursor: pointer;
      background: none;
      border: none;
      font-size: 1.2em;
    }

    /* 댓글 스타일 */
    .comment-list {
      margin-top: 20px;
    }

    .comment {
      border: 1px solid #ccc;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 5px;
    }

    .comment-author {
      font-weight: bold;
    }

    .comment-content {
      margin-top: 5px;
    }

    .comment-delete {
      float: right;
      cursor: pointer;
      background: none;
      border: none;
      color: red;
    }

    /* 댓글 입력 폼 */
    .comment-form {
      margin-top: 20px;
    }

    .comment-form textarea {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 5px;
      resize: vertical;
    }

    .comment-form button {
      margin-top: 10px;
      padding: 8px 15px;
      background-color: #4CAF50;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">홈</a>

  <!-- 메인 섹션 -->
  <main class="main">
    <h1><%= title %></h1>

    <div class="filters">
      <!-- 편의점별 필터 -->
      <div class="filter">
        <label for="convini-filter">편의점:</label>
        <select id="convini-filter" onchange="applyFilters()">
          <option value="">전체</option>
          <% availableConvinis.forEach(function(convini) { %>
            <option value="<%= convini %>" <%= locals.selectedConvini === convini ? 'selected' : '' %>><%= convini.toUpperCase() %></option>
          <% }); %>
        </select>
      </div>

      <!-- 카테고리별 필터 -->
      <div class="filter">
        <label for="category-filter">카테고리:</label>
        <select id="category-filter" onchange="applyFilters()">
          <option value="">전체</option>
          <% availableCategories.forEach(function(category) { %>
            <option value="<%= category %>" <%= locals.selectedCategory === category ? 'selected' : '' %>><%= category %></option>
          <% }); %>
        </select>
      </div>

      <!-- 가격별 정렬 -->
      <div class="filter">
        <label for="sort-filter">가격순:</label>
        <select id="sort-filter" onchange="applyFilters()">
          <option value="">기본</option>
          <option value="priceAsc" <%= locals.sortBy === 'priceAsc' ? 'selected' : '' %>>낮은 가격순</option>
          <option value="priceDesc" <%= locals.sortBy === 'priceDesc' ? 'selected' : '' %>>높은 가격순</option>
        </select>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="error-message"><%= errorMessage %></div>
    <% } %>

    <div class="product-list">
      <% products.forEach(function(product) { %>
      <div class="product-item" data-product-id="<%= product.id %>" data-tags="<%= product.tags.join(',') %>" data-price="<%= product.price %>">
        <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
        <h3><%= product.name %></h3>
        <p><%= product.price %>원</p>
        <button class="show-comments-button">댓글 보기</button>
      </div>

      <!-- Popup for comments -->
      <div class="product-popup" id="popup-<%= product.id %>">
        <button class="popup-close" onclick="closePopup('<%= product.id %>')"><i class="fas fa-times"></i></button>
        <h2><%= product.name %></h2>
        <div class="comment-list" id="comment-list-<%= product.id %>">
          <!-- Comments will be loaded here -->
        </div>
        <div class="comment-form">
          <textarea id="comment-input-<%= product.id %>" placeholder="댓글을 입력하세요"></textarea>
          <button onclick="addComment('<%= product.id %>')">댓글 작성</button>
        </div>
      </div>
      <% }); %>
    </div>
  </main>

  <script src="/static/js/script.js"></script>
  <script>
    function applyFilters() {
      const conviniFilter = document.getElementById('convini-filter').value;
      const categoryFilter = document.getElementById('category-filter').value;
      const sortFilter = document.getElementById('sort-filter').value;

      const params = new URLSearchParams();

      if (conviniFilter) params.append('convini', conviniFilter);
      if (categoryFilter) params.append('category', categoryFilter);
      if (sortFilter) params.append('sortBy', sortFilter);

      window.location.search = params.toString();
    }
  </script>
</body>
</html>