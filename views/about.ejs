<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/static/css/about.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    /* Popup 스타일 */
    .product-popup {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background-color: white;
      padding: 20px;
      border-radius: 5px;
      box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.2);
      z-index: 100;
      width: 80%;
      max-width: 600px;
      max-height: 80%;
      overflow-y: auto;
    }

    .product-popup.active {
      display: block;
    }

    .popup-close {
      position: absolute;
      top: 10px;
      right: 10px;
      cursor: pointer;
      background: none;
      border: none;
      font-size: 1.2em;
    }

    /* 댓글 섹션 스타일 */
    .comments-section {
      margin-top: 20px;
    }

    .comments-section h2 {
      margin-bottom: 10px;
    }

    .comment {
      border-bottom: 1px solid #ddd;
      padding: 10px 0;
    }

    .comment:last-child {
      border-bottom: none;
    }

    .comment-author {
      font-weight: bold;
    }

    .comment-content {
      margin: 5px 0;
    }

    .comment-actions {
      font-size: 0.9em;
      color: #555;
    }

    .comment-actions .edit-comment,
    .comment-actions .delete-comment {
      cursor: pointer;
      margin-right: 10px;
    }

    .add-comment-form {
      margin-top: 20px;
    }

    .add-comment-form textarea {
      width: 100%;
      height: 80px;
      padding: 10px;
      margin-bottom: 10px;
      resize: vertical;
    }

    .add-comment-form button {
      padding: 10px 20px;
    }

    /* 간단한 댓글 표시를 위한 스타일 */
    .product-item {
      position: relative;
    }

    .show-comments-button {
      position: absolute;
      bottom: 10px;
      left: 10px;
      background-color: #007BFF;
      color: white;
      border: none;
      padding: 5px 10px;
      cursor: pointer;
      border-radius: 3px;
    }

    .show-comments-button:hover {
      background-color: #0056b3;
    }

    /* 로딩 스피너 */
    .loading-spinner {
      display: none;
      text-align: center;
      margin-top: 20px;
    }

    .loading-spinner.active {
      display: block;
    }
  </style>
</head>
<body>
  <!-- 홈 버튼 -->
  <a href="/" class="home-button">홈</a>

  <!-- 메인 섹션 -->
  <main class="main">
    <h1><%= title %></h1>

    <div class="filters">
      <!-- 편의점별 필터 -->
      <div class="filter">
        <label for="convini-filter">편의점:</label>
        <select id="convini-filter" onchange="applyFilters()">
          <option value="">전체</option>
          <% availableConvinis.forEach(function(convini) { %>
            <option value="<%= convini %>" <%= selectedConvini === convini ? 'selected' : '' %>><%= convini.toUpperCase() %></option>
          <% }); %>
        </select>
      </div>

      <!-- 카테고리별 필터 -->
      <div class="filter">
        <label for="category-filter">카테고리:</label>
        <select id="category-filter" onchange="applyFilters()">
          <option value="">전체</option>
          <% availableCategories.forEach(function(category) { %>
            <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
          <% }); %>
        </select>
      </div>

      <!-- 가격별 정렬 -->
      <div class="filter">
        <label for="sort-filter">가격순:</label>
        <select id="sort-filter" onchange="applyFilters()">
          <option value="">기본</option>
          <option value="priceAsc" <%= sortBy === 'priceAsc' ? 'selected' : '' %>>낮은 가격순</option>
          <option value="priceDesc" <%= sortBy === 'priceDesc' ? 'selected' : '' %>>높은 가격순</option>
        </select>
      </div>
    </div>

    <% if (errorMessage) { %>
      <div class="error-message"><%= errorMessage %></div>
    <% } %>

    <div class="product-list">
      <% products.forEach(function(product) { %>
      <div class="product-item" data-product-id="<%= product.id %>" data-tags="<%= product.tags.join(',') %>" data-price="<%= product.price %>">
        <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
        <h3><%= product.name %></h3>
        <p><%= product.price %>원</p>
        <% if (userId) { %>
          <button class="show-comments-button" onclick="openCommentsPopup('<%= product.id %>')">댓글 보기</button>
        <% } else { %>
          <button class="show-comments-button" onclick="alert('로그인이 필요합니다.')">댓글 보기</button>
        <% } %>
      </div>
      <% }); %>
    </div>
  </main>

  <!-- 댓글 팝업 -->
  <div class="product-popup" id="comments-popup">
    <button class="popup-close" onclick="closeCommentsPopup()">&times;</button>
    <div class="popup-content">
      <h2 id="popup-product-name"></h2>
      <img id="popup-product-image" src="" alt="" style="max-width: 100%; height: auto;">
      <p id="popup-product-price"></p>

      <div class="comments-section">
        <h3>댓글</h3>
        <div id="comments-list">
          <!-- 댓글이 여기에 표시됩니다 -->
        </div>

        <% if (userId) { %>
          <div class="add-comment-form">
            <h4>댓글 작성</h4>
            <textarea id="new-comment-content" placeholder="댓글을 입력하세요"></textarea>
            <button onclick="submitComment()">작성</button>
          </div>
        <% } else { %>
          <p>댓글을 작성하려면 <a href="/login">로그인</a>하세요.</p>
        <% } %>
      </div>
    </div>
    <div class="loading-spinner" id="loading-spinner">
      <i class="fas fa-spinner fa-spin"></i> 로딩 중...
    </div>
  </div>

  <script src="/static/js/about.js"></script>
  <script>
    // 사용자 ID를 클라이언트 사이드에 전달 (if authenticated)
    const userId = "<%= userId ? userId : '' %>";
  </script>
  <script>
    function applyFilters() {
      const conviniFilter = document.getElementById('convini-filter').value;
      const categoryFilter = document.getElementById('category-filter').value;
      const sortFilter = document.getElementById('sort-filter').value;

      const params = new URLSearchParams();

      if (conviniFilter) params.append('convini', conviniFilter);
      if (categoryFilter) params.append('category', categoryFilter);
      if (sortFilter) params.append('sortBy', sortFilter);

      window.location.search = params.toString();
    }

    // 팝업 열기 함수
    function openCommentsPopup(productId) {
      loadComments(productId);
    }

    // 팝업 닫기 함수
    function closeCommentsPopup() {
      document.getElementById('comments-popup').classList.remove('active');
      document.getElementById('comments-list').innerHTML = '';
      if (document.getElementById('new-comment-content')) {
        document.getElementById('new-comment-content').value = '';
      }
    }
  </script>
</body>
</html>
