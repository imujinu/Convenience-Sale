<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>자유게시판</title>
    <!-- 공통 include -->
    <%- include("./include/include", { title: "자유게시판" }) %>
    <!-- 헤더 등 -->
    <link rel="stylesheet" href="/static/css/board.css" />
  </head>
  <body>
    <div class="header"><%- include("./include/header") %></div>

    <h1>자유게시판</h1>

    <div class="board-list">
      <table>
        <thead>
          <tr>
            <th>번호</th>
            <th>제목</th>
            <th>작성일</th>
            <th>작성자</th>
          </tr>
        </thead>
        <tbody>
          <% if (boardList && boardList.length > 0) { %> <%
          boardList.forEach(function (item) { %>
          <tr>
            <td><%= item.boardId %></td>
            <td>
              <a href="/board/view/<%= item.boardId %>"
                ><%= item.boardTitle %></a
              >
            </td>
            <td>
              <%= item.boardDate ? item.boardDate.toLocaleString() : "" %>
            </td>
            <td><%= item.userId ? item.userId : "" %></td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="4">게시글이 없습니다.</td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (isLogin) { %>
    <div class="write-btn">
      <a href="/board/write">글 작성</a>
    </div>
    <% } else { %>
    <p>글을 작성하려면 <a href="/login">로그인</a> 하세요.</p>
    <% } %>

    <script src="/static/js/board.js"></script>
  </body>
</html>
