<!-- cys2/241219/자유게시판 -->
<!DOCTYPE html>
<html lang="ko">
  <head>
    <link rel="stylesheet" href="/static/css/board.css" />
  </head>
  <body>
    <h1>자유 게시판</h1>
    <table>
      <tr>
        <th>분류</th>
        <th>작성일</th>
        <th>작성자</th>
        <th>제목</th>
      </tr>
      <% posts.forEach((post) => { %>
      <tr>
        <td><%= post.category %></td>
        <td><%= post.date %></td>
        <td><%= post.userId %></td>
        <td><a href="/board/view/<%= post.id %>"><%= post.title %></a></td>
      </tr>
      <% }) %>
    </table>
    <button onclick="location.href='/board/write'">글 작성</button>
  </body>
</html>
