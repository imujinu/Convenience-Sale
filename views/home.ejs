<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/static/css/home.css" />
    <%- include("./include/include",{title : "home"}) %>
    <!-- swiper CDN -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  </head>
  <body>
    <%- include("./include/header") %>
    <div class="section2 top1">
      <div class="part1">
        <div class="title">
          <h1>Fun Pick</h1>
        </div>
        <div class="contents">
          <p>편의점 쇼핑의 새로운 경험</p>

          <p>
            <b>CU,GS25,세븐일레븐</b>의 다양한 상품들을 <br />한 곳에서 쉽고
            빠르게 찾아보세요
          </p>
        </div>
        <div class="detail">쇼핑하기</div>
      </div>
      <div class="part2">
        <div class="arrow">
          <img src="/static/image/up.png" alt="" class="up" />
        </div>
      </div>
    </div>

    <div class="section3">
      <div class="swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide slide1">
            <img src="/static/image/img1.jpg" alt="" />
            <div class="viewBox"><span class="view">자세히보기</span></div>
          </div>
          <div class="swiper-slide slide2">
            <img src="/static/image/img2.jpg" alt="" />
            <div class="viewBox"><span class="view">자세히보기</span></div>
          </div>
          <div class="swiper-slide slide3">
            <img src="/static/image/img3.jpg" alt="" />
            <div class="viewBox"><span class="view">자세히보기</span></div>
          </div>

          <div class="swiper-slide slide4">
            <img src="./static/image/img4.jpg" alt="" />
            <div class="viewBox"><span class="view">자세히보기</span></div>
          </div>
        </div>
        <div class="swiper-pagination"></div>
        <div class="stop">
          <img src="/static/image/stopbtn2.png" alt="" class="stopBtn" />
        </div>
        <div class="swiper-button-prev">
          <img src="static/image/arrowleft.png" alt="" class="prev" />
        </div>
        <div class="swiper-button-next">
          <img src="static/image/arrowright.png" alt="" class="next" />
        </div>
      </div>
      <div class="modal modal1 hidden">
        <div class="modalContent">
          <img src="/static/image/modalimg1.jpg" alt="" />
        </div>
        <button class="modalCloseBtn modalCloseBtn1">
          <img src="/static//image/modalbtn.png" alt="" />
        </button>
      </div>
      <div class="modal modal2 hidden">
        <div class="modalContent">
          <img src="/static/image/modalimg2.jpg" alt="" />
        </div>
        <button class="modalCloseBtn modalCloseBtn2">
          <img src="/static/image/modalbtn.png" alt="" />
        </button>
      </div>
      <div class="modal modal3 hidden">
        <div class="modalContent">
          <img src="/static/image/modalimg3.jpg" alt="" />
        </div>
        <button class="modalCloseBtn modalCloseBtn3">
          <img src="/static/image/modalbtn.png" alt="" />
        </button>
      </div>
      <div class="modal modal4 hidden">
        <div class="modalContent">
          <img src="/static/image/modalimg4.jpg" alt="" />
        </div>
        <button class="modalCloseBtn modalCloseBtn4">
          <img src="/static/image/modalbtn.png" alt="" />
        </button>
      </div>
    </div>

    <div class="section4">
      <div class="part1">편의점 행사사상품</div>
      <div class="part2">
        <ul>
          <li class="all">전체</li>
          <li class="one">1+1</li>
          <li class="two">2+1</li>
        </ul>
      </div>
    </div>
    <div class="section5">
      <h1>CU</h1>
      <div class="container">
        <div class="product">
          <% for (let i = 0; i < CU.length; i++) { %>
          <div class="menu">
            <img
              src="/static/image/product/<%= CU[i].imagePath %>"
              alt="CU상품"
            />
            <p><%= CU[i].pName %></p>
            <p><%= CU[i].price %>원</p>
            <p class="event"><%= CU[i].event %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="section6">
      <h1>GS25</h1>
      <div class="container">
        <div class="product">
          <% for (let i = 0; i < GS25.length; i++) { %>
          <div class="menu">
            <img
              src="/static/image/product/<%= GS25[i].imagePath %>"
              alt="GS25상품"
            />
            <p><%= GS25[i].pName %></p>
            <p><%= GS25[i].price %>원</p>
            <p class="event"><%= GS25[i].event %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="section7">
      <h1>7ELEVEN</h1>
      <div class="container">
        <div class="product">
          <% for (let i = 0; i < ELEVEN.length; i++) { %>
          <div class="menu">
            <img
              src="/static/image/product/<%= ELEVEN[i].imagePath %>"
              alt="7ELEVEN상품"
            />
            <p><%= ELEVEN[i].pName %></p>
            <p><%= ELEVEN[i].price %>원</p>
            <p class="event"><%= ELEVEN[i].event %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="section8">
      <div class="container">
        <div class="part1">
          <h1>더 많은 상품을 보고싶다면?</h1>
          <p>Fun Pick의 다양한 상품들을 소개합니다!</p>

          <input
            type="text"
            placeholder="김치제육을 검색해보세요!"
            class="searchText"
          />
          <div class="search"></div>
        </div>
        <div class="part2">
          <div class="menu menu1">
            <img src="/static/image/menu1.png" alt="" />
            샐러드
          </div>
          <div class="menu menu2">
            <img src="/static/image/menu2.png" alt="" />
            샌드위치
          </div>
          <div class="menu menu3">
            <img src="/static/image/menu3.png" alt="" />
            삼각김밥
          </div>
          <div class="menu menu4">
            <img src="/static/image/menu4.png" alt="" />
            도시락
          </div>
        </div>
      </div>
    </div>
    <div class="section9">
      <div class="container">
        <div class="inner">
          <input
            type="email"
            placeholder="example@naver.com"
            required
            pattern="^[a-zA-Z0-9._%+\-]+@naver\.com$"
            title="네이버 메일 주소 형식(example@naver.com)으로 입력해주세요."
            class="email"
          />
          <button type="button" onclick="emailVerify()">등록하기</button>
        </div>
      </div>
    </div>
    <footer class="footer">
      <div class="container">
        <ul>
          <li>
            <a
              href="https://github.com/imujinu/Convenience-Sale"
              target="_blank"
            >
              Pureut
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>

          <li>
            <a href="https://github.com/imujinu" target="_blank">
              임진우
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>
          <li>
            <a href="https://github.com/YENANOAH" target="_blank">
              한예나
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>
          <li>
            <a href="https://github.com/yanjinlkham9" target="_blank">
              얀진람
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>
          <li>
            <a href="https://github.com/projectCHOI" target="_blank">
              최윤석
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>
          <li>
            <a href="https://github.com/digimonMania" target="_blank">
              김연준
              <img src="/static/image/git.png" alt="Git" />
            </a>
          </li>
        </ul>
        <div class="text">
          Copyright © 2024 Fun Pick Company 저작권법의 보호를 받습니다
        </div>
      </div>
    </footer>
    <script src="/static/js/home.js"></script>
  </body>
</html>
