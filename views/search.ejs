<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("./include/include", { title: "search" }) %>
    <link rel="stylesheet" href="/static/css/search.css" />
  </head>
  <body>
    <%- include("./include/header") %>

    <div class="section2">
      <div class="container">
        <h1>나만의 편의점 Fun Pick!</h1>
        <br />
        <h1>다양한 상품들을 확인해보세요</h1>
      </div>
    </div>

    <% if (isSearch) { %>
    <div class="section3">
      <div class="container">
        <ul>
          <li>전체상품</li>
          <li>CU</li>
          <li>GS25</li>
          <li>7ELEVEN</li>
        </ul>
      </div>
    </div>

    <div class="section4">
      <div class="container">
        <div><p>"<%= searchValue %>" 검색결과</p></div>
        <div>
          <input type="text" class="search" />
          <img src="/static/image/search.png" alt="" class="searchBtn" />
        </div>
        <br />
        <div>
          "<%= searchValue %>" 검색결과 총 <u>'<%= product.length %>'개</u>의
          상품이 검색되었습니다.
        </div>
      </div>
    </div>
    <div class="section5">
      <div class="container">
        <% for (let i = 0; i < product.length; i++) { %>
        <div class="product">
          <img
            src="/static/image/product/<%= product[i].imagePath %>"
            alt="편의점상품"
          />
          <span><p><%= product[i].pName %></p></span>
          <span><p><%= product[i].price %></p></span>
          <span><p><%= product[i].event %></p></span>
        </div>
        <% } %>
      </div>
    </div>
    <% } else { %>
    <div class="section3">
      <div class="container">
        <ul>
          <li>전체상품</li>
          <li>CU</li>
          <li>GS25</li>
          <li>7ELEVEN</li>
        </ul>
      </div>
    </div>

    <div class="section4">
      <div class="container">
        <div>
          <input type="text" class="search" />
          <img src="/static/image/search.png" alt="" class="searchBtn" />
        </div>
        <div class="noSearch"></div>
      </div>
    </div>
    <% } %>

    <script src="/static/js/search.js"></script>
  </body>
</html>
