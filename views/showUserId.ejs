<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title><%= product.name %> - 제품 상세</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  </head>
  <body>
    <header>
      <h1>제품 상세 페이지</h1>
      <% if (userId) { %>
      <p>안녕하세요, <%= userId %>님!</p>
      <a href="/logout">로그아웃</a>
      <% } else { %>
      <a href="/login">로그인</a>
      <a href="/register">회원가입</a>
      <% } %>
    </header>

    <main>
      <section class="product-details">
        <h2><%= product.name %></h2>
        <img
          src="<%= product.imageUrl %>"
          alt="<%= product.name %>"
          width="300"
        />
        <p>가격: ₩<%= product.price.toLocaleString() %></p>
        <p>편의점: <%= product.convini %></p>
        <p>
          태그: <% if (product.tags && product.tags.length > 0) { %> <%
          product.tags.forEach(tag => { %>
          <span class="tag"><%= tag %></span>
          <% }) %> <% } else { %> 없음 <% } %>
        </p>
      </section>

      <section class="comments">
        <h3>댓글</h3>

        <!-- 댓글 작성 폼 (로그인한 사용자만 표시) -->
        <% if (userId) { %>
        <form id="commentForm" action="/pcomments" method="POST">
          <input type="hidden" name="pId" value="<%= product.id %>" />
          <input type="hidden" name="userId" value="<%= userId %>" />
          <div>
            <label for="commentDetail">댓글 작성:</label>
            <textarea
              id="commentDetail"
              name="commentDetail"
              rows="3"
              required
            ></textarea>
          </div>
          <button type="submit">작성</button>
        </form>
        <% } else { %>
        <p>댓글을 작성하려면 <a href="/login">로그인</a>하세요.</p>
        <% } %>

        <!-- 댓글 목록 -->
        <ul class="comment-list">
          <% comments.forEach(comment => { %>
          <li data-comment-id="<%= comment.commentId %>">
            <p>
              <strong><%= comment.user.nickname %>:</strong> <%=
              comment.commentDetail %>
            </p>
            <p class="timestamp">
              작성일: <%= new Date(comment.createdAt).toLocaleString() %>
            </p>

            <% if (userId === comment.userId) { %>
            <!-- 댓글 수정 폼 (숨김 상태) -->
            <form
              class="edit-form"
              action="/pcomments/<%= comment.commentId %>"
              method="POST"
              style="display: none"
            >
              <input type="hidden" name="_method" value="PUT" />
              <div>
                <textarea name="commentDetail" rows="2" required>
<%= comment.commentDetail %></textarea
                >
              </div>
              <button type="submit">수정</button>
              <button type="button" class="cancel-edit">취소</button>
            </form>

            <!-- 수정 및 삭제 버튼 -->
            <button class="edit-comment">수정</button>
            <form
              class="delete-form"
              action="/pcomments/<%= comment.commentId %>"
              method="POST"
              style="display: inline"
            >
              <input type="hidden" name="_method" value="DELETE" />
              <button
                type="submit"
                onclick="return confirm('댓글을 삭제하시겠습니까?');"
              >
                삭제
              </button>
            </form>
            <% } %>
          </li>
          <% }) %>
        </ul>
      </section>
    </main>

    <footer>
      <p>&copy; 2024 Your Company</p>
    </footer>

    <script>
      // 댓글 수정 버튼 클릭 시 수정 폼 표시
      $(document).ready(function () {
        $(".edit-comment").click(function () {
          const li = $(this).closest("li");
          li.find(".comment-list").hide();
          li.find(".edit-form").show();
        });

        // 댓글 수정 취소 버튼
        $(".cancel-edit").click(function () {
          const li = $(this).closest("li");
          li.find(".edit-form").hide();
          // li.find('.comment-detail').show(); // 필요 시
        });
      });
    </script>
  </body>
</html>
