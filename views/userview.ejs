<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>회원정보수정</title>
    <%- include('./include/include.ejs') %>

    <link rel="stylesheet" href="/static/css/userview.css" />
  </head>
  <body>
    <div class="container">
      <div class="profile">
        <img
          id="profile-image"
          src="/uploads/default-profile1734600077533.jpg"
          alt="사용자 프로필 이미지"
        />
      </div>
      <div class="profileFile">
        <input class="btn1" type="file" name="user" id="user" />
        <button class="btn2" onclick="upload()">사진 업로드</button>
      </div>
      <!-- 회원정보 수정 변경  -->
      <ul class="infoBox">
        <li><span>아이디</span> <span>yena1111</span></li>
        <li><span>닉네임</span> <span>이나</span></li>
        <li>
          <span>새로운 닉네임</span>
          <span><input type="text" class="nickName" /></span>
          <button class="checkRedundanc">중복확인</button>
        </li>

        <li>
          <span>기존 비밀번호</span>
          <input
            type="password"
            name="userPw"
            id="userPw"
            placeholder="6~14자 영문, 숫자, 특수문자"
            pattern="^([a-z0-9A-Z._@!]{6,14}$)"
            title="소, 대 문자, 숫자, 특수문자 사용"
          />
          <button type="button">비밀번호 확인</button>
          <br />
          <span>새 비밀번호</span>
          <input
            type="password"
            name="userPw"
            id="userPw"
            placeholder="6~14자 영문, 숫자, 특수문자"
            pattern="^([a-z0-9A-Z._@!]{6,14}$)"
            title="소, 대 문자, 숫자, 특수문자 사용"
          />
        </li>
      </ul>

      <!-- 프로필 파일 업로드 -->
      <!-- <form action="/upload"> -->
      <!-- </form> -->
      <div class="buttonBox">
        <a href="/userview">
          <button type="submit" class="modifyBtn">회원정보 변경 완료</button>
        </a>
      </div>
    </div>
    <script>
      async function upload() {
        const file = document.querySelector("#user");
        const formData = new FormData();
        formData.append("user", file.files[0]);

        const uploadResult = await axios({
          url: "/upload",
          method: "post",
          data: formData,
          headers: {
            "Content-Type": "multipart/form-data",
          },
        });
        console.log(uploadResult);
        const path = uploadResult.data.path;
        const realPath = await path.replace(/\\/g, "/");
        const img = document.querySelector("#profile-image");
        img.src = `../${realPath}`;
      }
    </script>
  </body>
</html>
