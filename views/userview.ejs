<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- <title>회원정보수정</title> -->
    <%- include("./include/include",{title : "userview"}) %>
    <link rel="stylesheet" href="/static/css/userview.css" />
  </head>
  <body>
    <div class="container">
      <div class="profile">
        <img
          id="profile-image"
          src="<%=profilePath%>"
          alt="사용자 프로필 이미지"
        />
      </div>
      <div class="profileFile">
        <input class="btn1" type="file" name="user" id="user" />
        <button class="btn2" onclick="upload()">사진 업로드</button>
      </div>
      <!-- 회원정보 수정 변경  -->
      <ul class="infoBox">
        <li>
          <span>아이디:</span>
          <span><%=userId%> </span>
          <input type="hidden" id="userId" value="<%= userId %>" />
        </li>
        <li>
          <span>닉네임: </span> <span id="currentNickname"><%=nickname%></span>
        </li>
        <li>
          <span>새로운 닉네임:</span>
          <div class="nicknameBox">
            <input
              type="text"
              name="newNickname"
              id="newNickname"
              placeholder="새 닉네임 입력"
            />
            <button type="button" class="checkBtn" onclick="checkNickname()">
              중복확인
            </button>
          </div>
        </li>

        <li>
          <fieldset>
            <legend>비밀번호 변경:</legend>
            <span>기존 비밀번호</span>
            <input
              class="passwordNow"
              type="password"
              name="userPw"
              id="userPw"
              placeholder="6~14자 영문, 숫자, 특수문자"
              pattern="^([a-z0-9A-Z._@!]{6,14}$)"
              title="소, 대 문자, 숫자, 특수문자 사용"
            />
            <span>새 비밀번호</span>
            <input
              class="passwordNew"
              type="password"
              name="userPw"
              id="userPw"
              placeholder="6~14자 영문, 숫자, 특수문자"
              pattern="^([a-z0-9A-Z._@!]{6,14}$)"
              title="소, 대 문자, 숫자, 특수문자 사용"
            />
          </fieldset>
        </li>
        <li>
          <fieldset>
            <legend>회원 탈퇴:</legend>
            <span>비밀번호 확인:</span>
            <input type="password" name="removeUser" id="removeUser" />
            <button type="submit">회원 탈퇴</button>
          </fieldset>
        </li>
      </ul>

      <!-- 프로필 파일 업로드 -->
      <!-- <form action="/upload"> -->
      <!-- </form> -->
      <div class="buttonBox">
        <button type="submit" class="modifyBtn" onclick="updateUserBtn()">
          회원정보 변경 완료
        </button>
      </div>
    </div>
    <script>
      async function upload() {
        const file = document.querySelector("#user");
        const formData = new FormData();
        formData.append("user", file.files[0]);

        const uploadResult = await axios({
          url: "/upload",
          method: "post",
          data: formData,
          headers: {
            "Content-Type": "multipart/form-data",
          },
        });
        console.log(uploadResult);
        const path = uploadResult.data.path;
        const realPath = await path.replace(/\\/g, "/");
        const img = document.querySelector("#profile-image");
        img.src = `../${realPath}`;
      }
      async function checkNickname() {
        const newNickname = document.getElementById("newNickname").value.trim();
        try {
          const response = await axios.post("/checkNickname", {
            nickname: newNickname,
          });

          if (response.data.isDuplicate) {
            alert("이미 사용 중인 닉네임입니다.");
          } else {
            alert("사용 가능한 닉네임입니다.");
          }
        } catch (error) {
          console.error("Error during nickname check:", error);
          alert("닉네임 중복확인 중 오류가 발생했습니다.");
        }
      }

      async function updateUserBtn() {
        const userId = document.querySelector("#userId").value; // userId 가져오기
        const newNickname = document.querySelector("#newNickname").value.trim(); // 새로운 닉네임 가져오기
        try {
          const response = await axios.post("/updateUser", {
            userId,
            newNickname,
          });
          console.log("response", userId);
          if (response.data.success) {
            alert("회원 정보가 성공적으로 수정되었습니다.");

            location.reload(); // 성공 시 페이지 새로고침
          } else {
            alert("회원 정보 수정 실패: " + response.data.message);
          }
        } catch (error) {
          console.error("Error updating user:", error);
          alert("회원 정보 수정 중 오류가 발생했습니다.");
        }
      }
    </script>
  </body>
</html>
