<!DOCTYPE html>
<html lang="ko">
  <head>
    <link rel="stylesheet" href="/static/css/view.css" />
    <script src="/static/js/view.js"></script>
  </head>
  <body>
    <!-- 게시글 정보 표시 -->
    <h1><%= post.title %></h1>
    <p>분류: <%= post.category %></p>
    <p>작성일: <%= post.date %></p>
    <p>작성자: <%= post.userId %></p>
    <p><%= post.content %></p>

    <!-- 첨부 이미지 표시 -->
    <% if (post.file) { %>
    <h3>첨부 이미지</h3>
    <img
      src="/static/uploads/board/<%= post.file %>"
      alt="첨부 이미지"
      style="max-width: 500px"
    />
    <% } %>

    <!-- 댓글 표시 -->
    <h3>댓글</h3>
    <ul>
      <% (comments || []).forEach((comment) => { %>
      <li><%= comment.userId %>: <%= comment.text %></li>
      <% }) %>
    </ul>

    <!-- 댓글 작성 폼 -->
    <% if (user) { %>
    <form action="/board/view/<%= post.id %>/comment" method="post">
      <label>댓글: <input type="text" name="comment" required /></label>
      <button type="submit">작성</button>
    </form>
    <% } else { %>
    <p>댓글 작성은 <a href="/login">로그인</a> 후 가능합니다.</p>
    <% } %>

    <!-- 추가 버튼 -->
    <button onclick="window.location.href='/board'">나가기</button>
    <button id="deleteBtn">글 삭제</button>

    <!-- 글 삭제 팝업 -->
    <div id="deleteModal" style="display: none">
      <p>삭제를 위해 암호를 입력해주세요.</p>
      <label>암호키: <input type="password" id="deletePassword" /></label>
      <button id="confirmDelete">글 삭제</button>
      <button id="cancelDelete">삭제 취소</button>
    </div>

    <script>
      const deleteBtn = document.getElementById("deleteBtn");
      const deleteModal = document.getElementById("deleteModal");
      const confirmDelete = document.getElementById("confirmDelete");
      const cancelDelete = document.getElementById("cancelDelete");

      // 글 삭제 버튼 클릭 시 팝업 표시
      deleteBtn.addEventListener("click", () => {
        deleteModal.style.display = "block";
      });

      // 삭제 취소 버튼 클릭 시 팝업 숨김
      cancelDelete.addEventListener("click", () => {
        deleteModal.style.display = "none";
      });

      // 삭제 확인 버튼 클릭 시 서버에 요청 전송
      confirmDelete.addEventListener("click", () => {
        const password = document.getElementById("deletePassword").value;
        fetch("/board/delete/<%= post.id %>", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ password }),
        })
          .then((response) => {
            if (response.ok) {
              window.location.href = "/board";
            } else {
              alert("삭제 실패: 비밀번호가 일치하지 않습니다.");
            }
          })
          .catch((err) => {
            console.error(err);
          });
      });
    </script>
  </body>
</html>
