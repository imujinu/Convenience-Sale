<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>게시글 상세보기</title>
    <%- include("./include/include", { title: "자유게시판 - 상세보기" }) %>
    <link rel="stylesheet" href="/static/css/board.css" />
  </head>
  <body>
    <div class="header"><%- include("./include/header") %></div>

    <h1>게시글 상세보기</h1>

    <div class="board-view">
      <h2><%= post.boardTitle %></h2>
      <p>작성자: <%= post.userId %></p>
      <p>
        작성일: <%= post.boardDate ? post.boardDate.toLocaleString() : "" %>
      </p>
      <hr />
      <div class="detail-content"><%= post.boardDetail %></div>
      <% if (post.boardPicPath) { %>
      <div class="detail-image">
        <img src="<%= post.boardPicPath %>" alt="첨부 이미지" />
      </div>
      <% } %>
    </div>

    <hr />

    <!-- 댓글 목록 -->
    <h3>댓글</h3>
    <div class="comment-list">
      <% if (comments && comments.length > 0) { %> <% comments.forEach(function
      (comment) { %>
      <div class="comment-item">
        <p>
          <strong><%= comment.userId %></strong> | <%= comment.bcDate ?
          comment.bcDate.toLocaleString() : "" %>
        </p>
        <p><%= comment.bcDetail %></p>
        <hr />
      </div>
      <% }) %> <% } else { %>
      <p>댓글이 없습니다.</p>
      <% } %>
    </div>

    <!-- 댓글 작성 -->
    <% if (isLogin) { %>
    <h4>댓글 작성</h4>
    <form action="/board/view/<%= post.boardId %>/comment" method="POST">
      <textarea name="bcDetail" rows="3" required></textarea><br />
      <button type="submit">등록</button>
    </form>
    <% } else { %>
    <p>댓글을 작성하려면 <a href="/login">로그인</a> 하세요.</p>
    <% } %>

    <script src="/static/js/board.js"></script>
  </body>
</html>
