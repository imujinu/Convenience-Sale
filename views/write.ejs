<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>글 작성</title>
    <%- include("./include/include", { title: "자유게시판 - 글 작성" }) %>
    <link rel="stylesheet" href="/static/css/board.css" />
  </head>
  <body>
    <div class="header"><%- include("./include/header") %></div>

    <h1>글 작성</h1>

    <form action="/board/write" method="POST" enctype="multipart/form-data">
      <div>
        <label for="boardTitle">제목</label>
        <input type="text" name="boardTitle" id="boardTitle" required />
      </div>
      <div>
        <label for="boardDetail">내용</label>
        <textarea
          name="boardDetail"
          id="boardDetail"
          rows="5"
          required
        ></textarea>
      </div>
      <div>
        <label for="boardPic">이미지 첨부</label>
        <input type="file" name="boardPic" id="boardPic" />
      </div>

      <button type="submit">등록</button>
    </form>

    <script src="/static/js/board.js"></script>
  </body>
</html>
