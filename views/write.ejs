<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <title>글 작성</title>
    <link rel="stylesheet" href="/static/css/board.css" />
    <script src="/static/js/write.js"></script>
  </head>
  <body>
    <form action="/board/write" method="post" enctype="multipart/form-data">
      <label>제목: <input type="text" name="title" required /></label><br />
      <label
        >분류:
        <select name="category">
          <option>전체</option>
          <option>제품후기</option>
          <option>레시피 공유</option>
          <option>할인 정보</option>
          <option>잡수다</option>
        </select>
      </label>
      <br />
      <label>내용:<textarea name="content" required></textarea></label><br />
      <label>사진 업로드: <input type="file" name="file" /></label><br />
      <label
        >암호(숫자 4자리):
        <input type="text" name="password" pattern="\d{4}" required /></label
      ><br />
      <button type="submit">등록</button>
    </form>
  </body>
</html>
